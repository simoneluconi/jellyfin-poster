# Jellyfin Configuration
JELLYFIN_URL=http://your-jellyfin-ip:8096
JELLYFIN_API_KEY=your_api_key_here

# App Configuration
PORT=5000
DEBUG=False

# Seconds each poster stays on screen (carousel mode, minimum 5)
POSTER_DURATION=30

# Title under the poster: auto = hide it when the movie's logo is already printed on the poster,
# True = always show, False = never show
SHOW_TITLE=auto

# Show the movie's title logo from Jellyfin instead of the text title (when available)
SHOW_LOGOS=True

# Never show the same movie on two connected screens at the same time
SYNC_SCREENS=False
